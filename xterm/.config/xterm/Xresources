! xterm : Rosé Pine Moon, Cascadia Code
! Chargé par : xrdb -merge ~/.config/xterm/Xresources

! Session X : curseur et rendu des polices (xrdb)
Xcursor.theme: BreezeX-RosePine-Linux
Xcursor.size: 24

Xft.dpi: 96
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintmedium
Xft.rgba: none

! Police (rendu TrueType via Xft)
XTerm*renderFont: true
XTerm*faceName: Cascadia Code
XTerm*faceSize: 13

! Texte et fenêtre
XTerm*utf8: 1
XTerm*internalBorder: 8
XTerm*scrollBar: false
XTerm*saveLines: 10000

! Couleurs Rosé Pine Moon
XTerm*background: #232136
XTerm*foreground: #e0def4
XTerm*cursorColor: #c4a7e7
XTerm*highlightColor: #44415d
XTerm*highlightTextColor: #e0def4

XTerm*color0: #393552
XTerm*color1: #eb6f92
XTerm*color2: #3e8fb0
XTerm*color3: #f6c177
