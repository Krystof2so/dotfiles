######################################################################
# Ces commandes sont exécutées au démarrage d'une session X Openbox. #
######################################################################

# Ressources X en premier (synchrone)
xrdb -merge ~/.config/xterm/Xresources

# Environnement D-Bus/systemd pour portails et applications
dbus-update-activation-environment --systemd --all &

# Agent polkit
lxpolkit &

# Fond d'écran, compositeur, notifications, panneau
feh --bg-fill ~/dotfiles/IMG/wallpapers/NB-vallée_Oloron.jpg &
picom &
dunst &
tint2 &

# Clavier
numlockx on &
xsetroot -cursor_name left_ptr &

