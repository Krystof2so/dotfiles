######################################################################
# Ces commandes sont exécutées au démarrage d'une session X Openbox. #
######################################################################

# --- Fond d'écran ---
feh --bg-max ~/dotfiles/IMG/wallpapers/NB-vallée_Oloron.jpg &

# --- Compositeur X11 --- 
picom &

# --- Curseur --- 
xsetroot -cursor_name left_ptr &

# --- Notifications --- 
dunst &

# --- Panneau/Barre des tâches --- 
tint2 &

# --- Pavé numérique ---
numlockx on &

# --- Ressources X (xterm) ---
xrdb -merge ~/.config/xterm/Xresources &




